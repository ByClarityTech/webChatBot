# App
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Docling (worker container)
DOCLING_CACHE_DIR=/tmp/docling_cache
WORKER_URL=http://worker:8001
UPLOAD_DIR=/data/uploads

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=public_site_docs

# PostgreSQL (LangGraph checkpointer)
DATABASE_URL=postgresql://agent:agent@postgres:5432/public_assistant

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=public-docs-chatbot

# RAG
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
RAG_TOP_K=4

# AWS (Phase A6)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=public-assistant-docs

# Google Calendar OAuth (Phase B1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/admin/google/oauth/callback
# Railway production example:
# GOOGLE_OAUTH_REDIRECT_URI=https://<your-railway-api-host>/api/v1/admin/google/oauth/callback
GOOGLE_CALENDAR_ID=primary
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Booking / availability (Phase B1)
# Set to false to disable in-chat booking and public booking APIs (e.g. external Calendly link only)
BOOKING_ENABLED=true
BOOKING_SLOT_DURATION_MINUTES=30
BOOKING_SLOT_BUFFER_MINUTES=15
BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_RATE_LIMIT_PER_HOUR=10
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
BUSINESS_DAYS=1,2,3,4,5

# Admin login: email + password; the browser gets a signed JWT (HS256) in an httpOnly cookie.
# Create the first user with scripts/create_super_admin.py.
# Required. At least 32 random characters; changing it signs everyone out. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=24
# Leave unset: the cookie is Secure only when APP_ENV=production. Set true if dev runs on https.
# SESSION_COOKIE_SECURE=
# Lock an email+IP after this many failed logins within the window
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
# Next.js admin UI base URL — OAuth callback redirects here after Google consent
ADMIN_FRONTEND_URL=http://localhost:3000
# Railway production example:
# ADMIN_FRONTEND_URL=https://<your-railway-frontend-host>